{
  "name": "mymoney-workspace",
  "private": true,
  "scripts": {
    "dev:server": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "desktop:start": "npm start --prefix desktop",
    "desktop:build:linux": "npm run build:linux --prefix desktop",
    "desktop:build:win": "npm run build:win --prefix desktop"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
