{
  "name": "mymoney-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MyMoney — Aplicativo Desktop de Gestão Financeira Pessoal",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "start": "npm run prepare:app && electron .",
    "build:linux": "npm run prepare:app && electron-builder --linux",
    "build:win": "npm run prepare:app && electron-builder --win",
    "build:dir": "npm run prepare:app && electron-builder --dir"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^9.0.0",
    "@feriados/brasil": "file:../packages/feriados-brasil",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mymoney.app",
    "productName": "MyMoney",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.mjs",
      "app/backend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/frontend",
        "to": "frontend"
      },
      {
        "from": "app/backend/migrations",
        "to": "migrations"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyMoney",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
